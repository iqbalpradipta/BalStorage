pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        TARGET_PATH = '~/BalStorage'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            sh 'go vet ./...'
                            sh 'go test ./... -v -count=1'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'target-host', variable: 'TARGET_HOST'),
                    sshUserPrivateKey(credentialsId: 'target-host-ssh', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "mkdir -p ${TARGET_PATH}"
                        rsync -avz --delete \
                            -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no" \
                            --exclude=.git \
                            --exclude=node_modules \
                            --exclude=.next \
                            --exclude=*.exe \
                            --exclude=backend/uploads/ \
                            --exclude=.env \
                            --exclude=deploy/.env.production \
                            ./ ${TARGET_HOST}:${TARGET_PATH}/

                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "cd ${TARGET_PATH}/deploy && bash -s" <<'ENSURE_ENV'
                        set -euo pipefail

                        if [ ! -f .env.production ]; then
                            cp .env.production.example .env.production
                            echo "ERROR: deploy/.env.production was created from template. Fill DB and Discord secrets, then rerun deploy."
                            exit 1
                        fi

                        jwt_secret="$(grep -E '^JWT_SECRET=' .env.production | tail -n 1 | cut -d= -f2- || true)"
                        if [ "${#jwt_secret}" -lt 32 ] || [ "${jwt_secret#<}" != "${jwt_secret}" ]; then
                            if command -v openssl >/dev/null 2>&1; then
                                new_secret="$(openssl rand -hex 32)"
                            else
                                new_secret="$(dd if=/dev/urandom bs=48 count=1 2>/dev/null | base64 | tr -dc 'A-Za-z0-9' | cut -c1-64)"
                            fi

                            if grep -qE '^JWT_SECRET=' .env.production; then
                                sed -i "s|^JWT_SECRET=.*|JWT_SECRET=${new_secret}|" .env.production
                            else
                                printf '\nJWT_SECRET=%s\n' "${new_secret}" >> .env.production
                            fi
                            chmod 600 .env.production || true
                            echo "Generated a secure JWT_SECRET in deploy/.env.production"
                        fi
ENSURE_ENV

                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "cd ${TARGET_PATH}/deploy && docker compose build --pull --no-cache backend frontend && docker compose up -d --force-recreate --remove-orphans"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "sudo ln -sf ${TARGET_PATH}/deploy/nginx/cloud-storage.conf /etc/nginx/sites-enabled/cloud-storage && sudo nginx -t && sudo systemctl reload nginx"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([
                    string(credentialsId: 'target-host', variable: 'TARGET_HOST'),
                    sshUserPrivateKey(credentialsId: 'target-host-ssh', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh '''
                        sleep 10
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -fsS http://localhost:8000/api/v1/health && echo 'Backend OK'"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -fsS http://localhost:3000/api/health && echo 'Frontend OK'"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -fsS --resolve storage.iqbalpradipta.my.id:443:127.0.0.1 -o /dev/null https://storage.iqbalpradipta.my.id/ && echo 'Nginx HTTPS OK'"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed. Check Jenkins logs for details.'
        }
    }
}
