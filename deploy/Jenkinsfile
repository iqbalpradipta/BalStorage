pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        TARGET_PATH = '~/BalStorage'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            sh 'go vet ./...'
                            sh 'go test ./... -v -count=1'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'target-host', variable: 'TARGET_HOST'),
                    sshUserPrivateKey(credentialsId: 'target-host-ssh', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "mkdir -p ${TARGET_PATH}"
                        rsync -avz --delete \
                            -e "ssh -i ${SSH_KEY} -o StrictHostKeyChecking=no" \
                            --exclude=.git \
                            --exclude=node_modules \
                            --exclude=.next \
                            --exclude=*.exe \
                            --exclude=backend/uploads/ \
                            --exclude=.env \
                            --exclude=deploy/.env.production \
                            ./ ${TARGET_HOST}:${TARGET_PATH}/

                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "cd ${TARGET_PATH}/deploy && docker compose build --pull --no-cache backend frontend && docker compose up -d --force-recreate --remove-orphans"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "sudo ln -sf ${TARGET_PATH}/deploy/nginx/cloud-storage.conf /etc/nginx/sites-enabled/cloud-storage && sudo nginx -t && sudo systemctl reload nginx"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([
                    string(credentialsId: 'target-host', variable: 'TARGET_HOST'),
                    sshUserPrivateKey(credentialsId: 'target-host-ssh', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh '''
                        sleep 10
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf http://localhost:8000/api/v1/health && echo 'Backend OK' || echo 'Backend FAIL'"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf http://localhost:3000/api/health && echo 'Frontend OK' || echo 'Frontend FAIL'"
                        ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf -H 'Host: storage.iqbalpradipta.my.id' -o /dev/null -w '%{http_code}' http://localhost/ && echo ' Nginx OK' || echo 'Nginx FAIL'"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed. Check Jenkins logs for details.'
        }
    }
}
