pipeline {
    agent any

    environment {
        TARGET_PATH = '~/BalStorage'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            parallel {
                stage('Backend') {
                    steps {
                        dir('backend') {
                            sh 'go vet ./...'
                            sh 'go test ./... -v -count=1'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                sshagent(credentials: ['target-host-ssh']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "mkdir -p ${TARGET_PATH}"
                        rsync -avz --delete \
                            --exclude=.git \
                            --exclude=node_modules \
                            --exclude=.next \
                            --exclude=*.exe \
                            --exclude=backend/uploads/ \
                            --exclude=.env \
                            --exclude=deploy/.env.production \
                            ./ ${TARGET_HOST}:${TARGET_PATH}/

                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "cd ${TARGET_PATH}/deploy && docker compose up -d --build --remove-orphans"
                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "ln -sf ${TARGET_PATH}/deploy/nginx/cloud-storage.conf /etc/nginx/sites-enabled/cloud-storage && nginx -t && systemctl reload nginx"
                    '''
                }
            }
        }

        stage('Verify') {
            when {
                branch 'main'
            }
            steps {
                sshagent(credentials: ['target-host-ssh']) {
                    sh '''
                        sleep 10
                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf http://localhost:8000/api/v1/health && echo 'Backend OK' || echo 'Backend FAIL'"
                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf http://localhost:3000/api/health && echo 'Frontend OK' || echo 'Frontend FAIL'"
                        ssh -o StrictHostKeyChecking=no ${TARGET_HOST} "curl -sf -o /dev/null -w '%{http_code}' http://localhost/ && echo ' Nginx OK' || echo 'Nginx FAIL'"
                    '''
                }
            }
        }
    }

    post {
        failure {
            echo 'Deployment failed. Check Jenkins logs for details.'
        }
    }
}
